# =============================================================================
# OAuth relay (Deno Deploy / Deno local)
# Purpose: tunnel Google + Linux.do OAuth HTTP calls from a region that blocks
# them. The relay never stores OAuth secrets — credentials remain in the
# GoWith api container and are forwarded as header / body fields.
# =============================================================================

# Port the relay listens on (only used for `deno task dev` / `start`).
# Deno Deploy ignores this and uses its own edge runtime.
PORT=8000

# Shared secret presented by the GoWith api as `X-Relay-Token`.
# Must match the value of OAUTH_RELAY_TOKEN in apps/api env.
# Length >= 32 recommended; rotate by editing both sides.
RELAY_SHARED_SECRET=replace-with-32-byte-random-secret

# Per-provider upstream overrides. Leave empty to use the hard-coded defaults
# below. These are the ONLY hostnames the relay will connect to — anything
# else returns 404 to keep the surface tiny.
#
# GITHUB_TOKEN_UPSTREAM=https://github.com/login/oauth/access_token
# GITHUB_USERINFO_UPSTREAM=https://api.github.com/user
# GOOGLE_TOKEN_UPSTREAM=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_UPSTREAM=https://openidconnect.googleapis.com/v1/userinfo
# LINUXDO_TOKEN_UPSTREAM=https://connect.linux.do/oauth2/token
# LINUXDO_USERINFO_UPSTREAM=https://connect.linux.do/api/user

# Per-request upstream timeout in milliseconds. Provider typically answers
# within 5 s; we give 10 s headroom before aborting.
UPSTREAM_TIMEOUT_MS=25000

# Comma-separated allow-list of origins the relay will accept CORS preflights
# from. Leave empty to disable CORS (only same-origin / curl will work).
# Example: https://gowith.xiaobaozi.cn
CORS_ALLOWED_ORIGINS=

# Log level: debug | info | warn | error
LOG_LEVEL=info
